{
  "$schema": "https://schema.tauri.app/config/2", "productName": "DittoCard", "mainBinaryName": "DittoCard", "version": "0.2.0", "identifier": "com.aircard.desktop",
  "build": {"beforeDevCommand": "pnpm web", "devUrl": "http://localhost:1420", "beforeBuildCommand": "pnpm build", "frontendDist": "../dist"},
  "app": {"windows": [{"title": "DittoCard", "hiddenTitle": true, "width": 1100, "height": 780, "minWidth": 820, "minHeight": 600}], "security": {"csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; script-src 'self'"}},
  "bundle": {"active": true, "targets": ["nsis"], "icon": ["icons/icon.ico", "icons/icon.icns", "icons/icon.png"], "resources": {"binaries/backend/": "backend/"}, "windows": {"nsis": {"installMode": "currentUser", "languages": ["English", "SimpChinese"], "displayLanguageSelector": true}, "webviewInstallMode": {"type": "downloadBootstrapper"}}, "macOS": {"minimumSystemVersion": "14.0"}}
}
